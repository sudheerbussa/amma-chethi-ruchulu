{
  "name": "acr-fresh-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ACR-Fresh WhatsApp order bot — vegetables + hourly delivery slots (Meta Cloud API)",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "start:prod": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "package": "bash scripts/package.sh",
    "db:init": "node src/db.js --init",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import-json": "node scripts/import-json-to-pg.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "open-location-code": "^1.0.3",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.0"
  }
}
