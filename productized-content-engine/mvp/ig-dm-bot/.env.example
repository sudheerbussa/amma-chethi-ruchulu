# Facebook Page linked to ACR Instagram (from me/accounts)
PAGE_ID=

# Instagram professional account id (instagram_business_account.id)
IG_USER_ID=

# Long-lived Page access token with:
# pages_messaging, instagram_manage_comments, pages_manage_metadata,
# pages_read_engagement, pages_show_list (+ existing publish scopes OK)
ACCESS_TOKEN=

# Webhook verify token — you invent this; same string in Meta App Dashboard
VERIFY_TOKEN=

# App → Settings → Basic → App Secret (signature check)
APP_SECRET=

# Dev only — never enable on production once Meta webhooks are live
# SKIP_SIGNATURE=1

GRAPH_API_VERSION=v21.0
PORT=3010

# Optional: path to JSON rules file (default clients/acr.json)
# RULES_PATH=./clients/acr.json

# Dedupe store (comment ids already replied)
DEDUPE_PATH=/data/ig-dm-bot/processed-comments.json
