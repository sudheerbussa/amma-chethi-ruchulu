{
  "name": "amma-chethi-ruchulu-order-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "start:prod": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "package": "bash scripts/package.sh",
    "db:init": "node src/db.js --init",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import-json": "node scripts/import-json-to-pg.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
