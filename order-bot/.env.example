
# Rider portal (v1b hub). Same RIDER_SESSION_SECRET (or ADMIN_TOKEN) on both bots.
# RIDER_SESSION_SECRET=
# RIDER_HUB_URL=https://order.ammachethiruchulu.co.in/rider
# RIDER_FOOD_APP_URL=https://order.ammachethiruchulu.co.in/rider/app
# RIDER_FRESH_APP_URL=https://fresh.ammachethiruchulu.co.in/rider/app
# RIDER_SISTER_SYNC_URL=https://fresh.ammachethiruchulu.co.in

# Optional: Fresh Postgres for consolidated Food admin cashbook (same host sibling .env).
# FRESH_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/<DB_NAME>

# Late same-day lunch (after 1PM) / dinner (after 8PM): customer calls this number; admin places manual order.
# ORDER_CONFIRM_PHONE=9392044833

# Delivery windows: continuous 12:30 PM–11:30 PM · last start 11:00 PM · 90 min lead · last WA/web order 9:30 PM
# DELIVERY_SLOT_LEAD_MINUTES=90
# DELIVERY_SLOT_CAPACITY=0

# Food web menu (Phase 1–4): https://order…/food — WhatsApp CTA number (E.164)
# STOREFRONT_WHATSAPP=919823583498
# Optional HMAC secret for WA→web deep links (defaults to ADMIN_TOKEN)
# STOREFRONT_LINK_SECRET=
