# Copy to .env and fill after Meta WhatsApp Cloud API is ready

PORT=3000
TZ=Asia/Kolkata

# Order rules (paise). 100 paise = ₹1.
# Min food total seed when ops-settings not yet saved (admin can change live).
# 100 paise = ₹1. Live tip: 10000 = ₹100. Prefer Admin → Offers → Min order.
MIN_ORDER_PAISE=0
# FREE_DELIVERY_ABOVE_PAISE=30000


# Meta Cloud API
WHATSAPP_VERIFY_TOKEN=amma_chethi_verify_change_me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Local JSON store — only when DATABASE_URL is empty (local/dev, or ALLOW_JSON_DB=1 in prod)
DATABASE_PATH=./data/orders.json

# ── Postgres (required on VPS production) ────────────────────────
# Production (NODE_ENV=production via pm2): bot refuses to start without DATABASE_URL
# unless ALLOW_JSON_DB=1 (emergency only).
# Local: leave DATABASE_URL empty → JSON file.
#
# Local Docker: docker compose up -d
# DATABASE_URL=postgres://acr:acr_dev@127.0.0.1:5432/acr_orders
# VPS:     DATABASE_URL=postgres://acr:STRONG_PASSWORD@127.0.0.1:5432/acr_orders
#          npm run db:migrate
# Full steps: see SETUP-VPS.md

# Brand
BUSINESS_NAME=Amma Chethi Ruchulu
SUPPORT_PHONE=918886128995

# UPI — used when Razorpay is off, or when UPI_FALLBACK=1 alongside Razorpay
UPI_ID=friend@upi
UPI_PAYEE_NAME=OPS PARTNER NAME
UPI_QR_PATH=./assets/upi-qr.jpeg
# With Razorpay keys set: leave 0 (Razorpay only). Set 1 to also send UPI QR + PAID.
UPI_FALLBACK=0

# Razorpay Standard Checkout (test keys rzp_test_… first; live keys later)
# Leave empty for UPI-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Base URL for WhatsApp pay links → /pay/<ORDER_REF>
PUBLIC_BASE_URL=https://order.ammachethiruchulu.co.in
# Razorpay Dashboard → Webhooks → endpoint secret (production recommended)
# URL: https://order.ammachethiruchulu.co.in/api/razorpay-webhook
# Events: payment.captured
# RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Community invite (optional). Soft prompt after pay / delivery / feedback.
# Create Community in WhatsApp app → Invite via link → paste here.
# WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/XXXXXXXX

# Admin WhatsApp allowlist (country code, no +) + dashboard token
ADMIN_PHONES=918055292935,918886128995
# Admin UI login: username (default superadmin) + password = ADMIN_TOKEN
# Full VPS prerequisites: see VPS-REQUIREMENTS.md
ADMIN_USER=superadmin
ADMIN_TOKEN=change-me-local-admin
