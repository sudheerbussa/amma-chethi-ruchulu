---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CtaBand from '../../components/CtaBand.astro';
import { topics } from '../../data/topics';
import { breadcrumbSchema } from '../../lib/schema';
import { site } from '../../site.config';
---

<BaseLayout
  title={`Guides & Topics — ${site.nameEn}`}
  description="Topic pages for home cooked food delivery, tiffin, WhatsApp ordering, and Andhra meals in Tenali."
  canonicalPath="/topics/"
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Topics', path: '/topics/' },
    ]),
  ]}
>
  <SiteHeader current="topics" />
  <main id="main">
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h1>Topics people search for</h1>
          <p>
            Practical pages for the meals and intents customers already type into Google—each with a clear
            WhatsApp path to order.
          </p>
        </div>
        <ul class="link-grid">
          {
            topics.map((t) => (
              <li>
                <a href={`/topics/${t.slug}/`}>
                  <strong>{t.h1}</strong>
                  <span>{t.keyword}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <CtaBand />
  </main>
  <SiteFooter />
</BaseLayout>
